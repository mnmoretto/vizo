# ==============================================================================
# Vizo — Variáveis de Ambiente (Supabase)
# ==============================================================================
# Copie este arquivo para `.env.local` e preencha com as credenciais do seu
# projeto no Supabase (Project Settings -> API).
#
# Enquanto estas variáveis estiverem vazias, o app exibe um aviso e libera
# um Modo Demonstração local para testar o fluxo de Login -> Onboarding -> Home.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
